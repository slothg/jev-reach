{
  "name": "jev-reach",
  "version": "0.1.1-slothg.10",
  "description": "chrome-devtools-mcp plus one tool: Jev walks the browser to the spot, Claude makes one devtools call there.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slothg/jev-reach.git"
  },
  "homepage": "https://github.com/slothg/jev-reach#readme",
  "bugs": {
    "url": "https://github.com/rashedInt32/jev-reach/issues"
  },
  "bin": {
    "jev-reach": "dist/index.js",
    "jev-reach-bridge": "dist/bridge.js"
  },
  "files": [
    "vendor",
    "dist",
    "scripts",
    "patches",
    "docs/shared-service",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "chrome-devtools",
    "browser",
    "typesafe",
    "jev",
    "system-one",
    "agent"
  ],
  "scripts": {
    "postinstall": "node scripts/apply-devtools-patches.mjs",
    "prebuild": "node scripts/apply-devtools-patches.mjs",
    "patch:devtools": "node scripts/apply-devtools-patches.mjs",
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "JEV_REACH_E2E=1 node --test test/e2e.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@slothg/jev-vision": "file:vendor/slothg-jev-vision-0.1.0.tgz",
    "@typesafe-ai/sdk": "0.7.0",
    "chrome-devtools-mcp": "1.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "puppeteer-core": "25.10.0",
    "typescript": "^5.6.0",
    "zod": "^3.25.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "bundleDependencies": [
    "@slothg/jev-vision"
  ],
  "publishConfig": {
    "access": "public"
  }
}
